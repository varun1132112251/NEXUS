# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Application settings
APP_NAME=NEXUS API
ENVIRONMENT=local
DEBUG=false

# Comma-separated frontend origins allowed to access the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT configuration
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Authentication tickets
AUTH_TICKET_EXPIRE_MINUTES=10

# Google Identity Services
GOOGLE_CLIENT_ID=

# Email delivery (leave SMTP_HOST empty for local console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173
