# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Application settings
APP_NAME=NEXUS API
ENVIRONMENT=local
DEBUG=false

# JWT configuration
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60\n\n# Comma-separated browser origins allowed to call the API.\nCORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173